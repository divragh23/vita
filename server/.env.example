# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ── For DigitalOcean deployment (fill in later) ───────────────
PORTFOLIO_ORIGIN=https://yourdomain.com

# ── Optional ──────────────────────────────────────────────────
PORT=3001
RATE_LIMIT_PER_MIN=15

# ── Feedback email (Gmail) ────────────────────────────────────
# SMTP_USER is the Gmail address that SENDS the feedback.
# SMTP_PASS is a Gmail "App Password" (NOT your normal password).
# Create one at: https://myaccount.google.com/apppasswords
# FEEDBACK_TO is where feedback is delivered (kept server-side only).
SMTP_USER=your_sending_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
FEEDBACK_TO=divragh65@gmail.com
